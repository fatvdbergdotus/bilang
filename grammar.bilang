grammar org.bilang.language.Idsl with org.eclipse.xtext.common.Terminals

generate bilang "http://www.bilang.org/language/Bilang"

Model: Task | CompoundProcess | AbstractProcess;

Task: SendTask | RetrieveTask | PersonTask;
CompoundProcess: 'compound' 'process' ('task' task+=Task)+;
AbstractProcess: 'abstract' 'process' 'with' 'name' name=STRING 'and' paramValues+=ParamValue+;

ParamValue: 'parameter' param=STRING 'value' value=STRING;

RetrieveTask: RetrieveDocument | RetrieveFullAddress;
SendTask: SendEmail | SendSMS | SendSnailMail;
PersonTask: CallPerson | AddPerson | DeletePerson;

SendEmail: 'send' 'an' 'email' 'to' person+=Person+ 'with' 'content' content=Content;
SendSMS: 'send' 'an' 'sms' 'to' person+=Person+ 'with' 'content' content=Content;
SendSnailMail: 'send' 'a' 'snail' 'mail' 'to' person+=Person+ 'with' 'content' content=Content;
RetrieveDocument: 'retrieve' 'document' document | Document;
RetrieveFullAddress: 'retrieve' 'street' 'and' 'city' 'of' personAdress=PersonByAddress;
CallPerson: 'phone' 'call' person=Person;
AddPerson: 'add' alias=PersonByAlias ('and' person+=Person)+
DeletePerson: 'delete' alias=PersonByAlias;

Person: PersonByEmail | PersonByAlias | PersonByName | PersonByPhone | PersonByAddress;
PersonByEmail: 'person' 'with' 'email' emailaddress=EmailAddress;
PersonByAlias: 'person' 'with' 'alias' alias=ID;
PersonByName: 'person' 'with' 'firstname' firstName=ID 'and' 'lastname' lastName=ID;
PersonByPhone: 'person' 'with' 'phone' 'number' phone=PhoneNumber;
PersonByAddress: 'person' 'with' 'zip' 'code' zipcode=ID 'and' 'housenumber' housenumber=Housenumber;

Content: Message | Document;
Message: 'message' message=STRING;

Document: Invoice | DocumentPerson;
Invoice: 'invoice' 'with' 'code' code=STRING;
DocumentPerson: 'information' 'about' person=Person

EmailAddress:
    localPart=LocalPart '@' domain=Domain
LocalPart:
    value=ID ('.' value=ID)*;
Domain:
    parts+=ID ('.' parts+=ID)+;

PhoneNumber returns ecore::EString:
    ('+' | '0'..'9') ('0'..'9' | '-' | ' ')*;

Housenumber: number=INT (extension=ID)?;
