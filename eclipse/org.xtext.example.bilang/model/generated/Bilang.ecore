<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="bilang" nsURI="http://www.xtext.org/example/bilang/Bilang" nsPrefix="bilang">
  <eClassifiers xsi:type="ecore:EClass" name="Model"/>
  <eClassifiers xsi:type="ecore:EClass" name="Task" eSuperTypes="#//Model">
    <eStructuralFeatures xsi:type="ecore:EReference" name="kind" upperBound="-1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EObject"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CompoundProcess" eSuperTypes="#//Model">
    <eStructuralFeatures xsi:type="ecore:EReference" name="task" upperBound="-1" eType="#//Task"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AbstractProcess" eSuperTypes="#//Model">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="paramValues" upperBound="-1"
        eType="#//ParamValue" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ParamValue">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="param" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RetrieveTask"/>
  <eClassifiers xsi:type="ecore:EClass" name="SendTask">
    <eStructuralFeatures xsi:type="ecore:EReference" name="person" upperBound="-1"
        eType="#//Person" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="content" eType="#//Content"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PersonTask"/>
  <eClassifiers xsi:type="ecore:EClass" name="SendEmail" eSuperTypes="#//SendTask"/>
  <eClassifiers xsi:type="ecore:EClass" name="SendSMS" eSuperTypes="#//SendTask"/>
  <eClassifiers xsi:type="ecore:EClass" name="SendSnailMail" eSuperTypes="#//SendTask"/>
  <eClassifiers xsi:type="ecore:EClass" name="RetrieveDocument" eSuperTypes="#//RetrieveTask">
    <eStructuralFeatures xsi:type="ecore:EReference" name="document" eType="#//Document"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RetrieveFullAddress" eSuperTypes="#//RetrieveTask">
    <eStructuralFeatures xsi:type="ecore:EReference" name="personAdress" eType="#//PersonByAddress"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RetrievePersons" eSuperTypes="#//RetrieveTask">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="personSearch" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CallPerson" eSuperTypes="#//PersonTask">
    <eStructuralFeatures xsi:type="ecore:EReference" name="person" eType="#//Person"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AddPerson" eSuperTypes="#//PersonTask">
    <eStructuralFeatures xsi:type="ecore:EReference" name="alias" eType="#//PersonByAlias"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="person" upperBound="-1"
        eType="#//Person" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DeletePerson" eSuperTypes="#//PersonTask">
    <eStructuralFeatures xsi:type="ecore:EReference" name="alias" eType="#//PersonByAlias"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Person"/>
  <eClassifiers xsi:type="ecore:EClass" name="PersonByEmail" eSuperTypes="#//Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="emailaddress" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PersonByAlias" eSuperTypes="#//Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="alias" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PersonByName" eSuperTypes="#//Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PersonByPhone" eSuperTypes="#//Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="phone" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PersonByAddress" eSuperTypes="#//Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="zipcode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="housenumber" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Content"/>
  <eClassifiers xsi:type="ecore:EClass" name="Message" eSuperTypes="#//Content">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="message" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Document" eSuperTypes="#//Content"/>
  <eClassifiers xsi:type="ecore:EClass" name="Invoice" eSuperTypes="#//Document">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DocumentPerson" eSuperTypes="#//Document">
    <eStructuralFeatures xsi:type="ecore:EReference" name="person" eType="#//Person"
        containment="true"/>
  </eClassifiers>
</ecore:EPackage>
